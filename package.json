{
  "name": "agent-config",
  "version": "0.1.0",
  "description": "Companion MCP server for Agent Config: host inspection, profile persistence, and cross-harness execution configuration",
  "type": "module",
  "main": "dist/server/index.js",
  "bin": {
    "agent-config": "dist/server/index.js"
  },
  "files": [
    "dist",
    "schemas",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "prebuild": "rm -rf dist",
    "build": "tsc",
    "postbuild": "chmod +x dist/server/index.js",
    "prepare": "npm run build",
    "watch": "tsc -w",
    "start": "node dist/server/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "check:types": "tsc --noEmit"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "agent-config",
    "host-adapter",
    "execution-configuration"
  ],
  "author": "Light",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/LightDevCoder/agent-config.git"
  },
  "homepage": "https://github.com/LightDevCoder/agent-config#readme",
  "bugs": {
    "url": "https://github.com/LightDevCoder/agent-config/issues"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.5.0",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "jsonc-parser": "^3.3.1",
    "smol-toml": "^1.8.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.10.7",
    "typescript": "^5.7.3",
    "vitest": "^3.0.4"
  }
}
