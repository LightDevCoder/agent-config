{
  "name": "agent-config",
  "version": "0.1.0",
  "description": "Companion MCP server for Agent Config: host inspection, profile persistence, and cross-harness execution configuration",
  "type": "module",
  "main": "dist/server/index.js",
  "bin": {
    "agent-config": "dist/server/index.js"
  },
  "scripts": {
    "build": "tsc",
    "watch": "tsc -w",
    "start": "node dist/server/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "check:types": "tsc --noEmit"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "agent-config",
    "host-adapter",
    "execution-configuration"
  ],
  "author": "Light",
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.5.0",
    "jsonc-parser": "^3.3.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.10.7",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "typescript": "^5.7.3",
    "vitest": "^3.0.4"
  }
}
